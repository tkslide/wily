SHELL=/bin/sh
srcdir=@srcdir@
VPATH=@srcdir@

WINBIN = win/win win/wgoto win/wreplace
SUBDIRS=libXg libframe libmsg wily win

all:	wily/wily $(WINBIN)

wily/wily: libXg/libXg.a libframe/libframe.a libmsg/libmsg.a
	cd wily; $(MAKE) $(MFLAGS)

libXg/libXg.a:
	cd libXg; $(MAKE) $(MFLAGS)

libframe/libframe.a:
	cd libframe; $(MAKE) $(MFLAGS) all

libmsg/libmsg.a:
	cd libmsg; $(MAKE) $(MFLAGS) all

$(WINBIN):
	cd win; $(MAKE) $(MFLAGS) all

install:	all
	(cd wily; $(MAKE) $(MFLAGS) install)
	(cd win; $(MAKE) $(MFLAGS) install)

clean:
	for i in $(SUBDIRS); do \
		(cd $$i; $(MAKE) $(MFLAGS) $@); \
	done
nuke:
	for i in $(SUBDIRS); do \
		(cd $$i; $(MAKE) $(MFLAGS) $@); \
	done
	-rm -rf wily.* \
		autom4te.cache/ \
		config.cache config.h config.log config.status config.h.in configure \
		Makefile libXg/Makefile libmsg/Makefile libframe/Makefile \
		wily/wily win/win win/wgoto win/wreplace


distclean: nuke
