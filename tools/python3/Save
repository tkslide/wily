#! /usr/bin/env python3

import wily
from os import chmod

SAVEFILE = "Restore"

c = wily.Connection()


l = c.list()
wl = []
for win in sorted(l, key=lambda tup: tup[-1]):
        pos = c.goto(int(win[1]),0,0,":.",0)
        wl.append( ( win[0], int(win[1]), f"#{pos[1]}", f"#{pos[2]}" ) )

with open(SAVEFILE, "w") as f:
    f.write("#! /usr/bin/env python3\n")
    f.write("# Automatically generated with Save\n# DO NOT EDIT\n\n")
    f.write("import wily\n")
    f.write("from sys import argv\n")
    f.write("c = wily.Connection()\n\n")
    f.write(f"wins = {wl}\n")
    f.write("""
# Remove existing tiles
if len(argv) > 1 and argv[-1]=="-f":
    for win in c.list():
        c.run(int(win[1]), "Del")
# Open saved tiles
for win in wins:
    w = c.win(win[0], 1)
    c.goto(w, 0,0,f"{win[0]}:{win[2]},{win[3]}", 1)
""")


chmod(SAVEFILE, 0o755)
